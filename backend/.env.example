APP_NAME="SMK Nurul Jadid"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration untuk MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_smknuruljadid
DB_USERNAME=root
DB_PASSWORD=

# Laravel Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,localhost:3000
SANCTUM_TOKEN_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@smknuruljadid.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# AWS Configuration (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI Chatbot Configuration (Optional)
AI_PROVIDER=openai
AI_API_KEY=
# Supported providers: openai, anthropic, google
# OpenAI API Key: https://platform.openai.com/api-keys
# Anthropic API Key: https://console.anthropic.com/
# Google AI API Key: https://makersuite.google.com/app/apikey

# Security Configuration
SECURITY_RATE_LIMIT=60
SECURITY_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_TIME=15
SECURITY_PASSWORD_EXPIRY_DAYS=90
SECURITY_SESSION_TIMEOUT=120

# File Upload Configuration
MAX_FILE_SIZE=5242880
MAX_UPLOAD_FILES=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp,pdf,doc,docx,xls,xlsx,zip

VITE_APP_NAME="${APP_NAME}"
